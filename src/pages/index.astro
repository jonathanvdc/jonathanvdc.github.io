---
import BaseLayout from '../layouts/BaseLayout.astro';
import CompilerProjectCard from '../components/CompilerProjectCard.astro';
import { compilerProjects } from '../data/compilerProjects.js';

const featuredProjects = compilerProjects.filter((project) => project.featured);
---

<BaseLayout title="Jonathan Van der Cruysse" description="Personal website of Jonathan Van der Cruysse: research, software projects, talks, and teaching.">
  <section class="home-page">
    <section class="home-hero">
      <h1>Hi, I’m Jonathan.</h1>
      <p>
        My research explored equality saturation and its applications to program
        optimization and FPGA design, with
        <a href="https://cdubach.bitbucket.io">Christophe Dubach</a> as my PhD supervisor.
      </p>
      <p>This site collects my research, software projects, talks, and teaching.</p>
      <div class="home-hero__actions">
        <a class="button" href="/compiler-work/">Projects</a>
        <a class="button button--secondary" href="/publications/">Publications</a>
      </div>
    </section>

    <section class="home-featured" aria-labelledby="selected-projects-title">
      <div class="compiler-section-heading">
        <h2 id="selected-projects-title">Selected projects</h2>
        <a href="/compiler-work/">All projects →</a>
      </div>
      <div class="compiler-grid compiler-grid--featured">
        {featuredProjects.map((project) => <CompilerProjectCard project={project} />)}
      </div>
    </section>
  </section>
</BaseLayout>
